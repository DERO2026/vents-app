<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Custom-scheme deep link (works immediately, no domain
                 verification needed) — handled by the appUrlOpen listener
                 in src/app/App.tsx. e.g. vents://open?event=<id> -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="vents" />
            </intent-filter>
            <!-- getvents.com App Link. autoVerify requires a hosted
                 /.well-known/assetlinks.json (release signing cert SHA-256
                 fingerprint) to actually auto-open the app instead of the
                 browser — not yet set up. Until then this intent-filter is
                 inert (Android falls back to the browser), which is safe. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="getvents.com" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- "Providers Near You" (Services) -- distance-sorted discovery via
         the WebView's own navigator.geolocation, not a separate native
         plugin. COARSE is enough for city/neighborhood-level provider
         discovery; FINE is declared too so the OS offers precise location
         if the user grants it, but the app never requires it. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- RECORD_AUDIO intentionally NOT declared here. Chat voice notes
         (getUserMedia/MediaRecorder in the WebView) are gated off by
         app_config.voice_notes_enabled (DEFAULT false — see
         migrations/20260710185537_media-feature-toggles.sql) and were
         disabled for MVP launch. A declared-but-unused RECORD_AUDIO
         permission risks a Play Store review flag with zero feature
         benefit while the toggle stays off. Re-add this line (and rebuild/
         resubmit the native app) before ever flipping voice_notes_enabled
         to true in Production — without it, getUserMedia's mic request
         will be denied outright at the OS level on Android, before the
         WebView ever gets a chance to prompt. -->
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <!-- Required for the organizer ticket check-in scanner (getUserMedia
         video in the WebView via html5-qrcode). Without this, the OS denies
         camera access outright before the WebView ever gets a chance to
         prompt — the scanner screen would show a black box with no camera
         permission dialog and no visible error. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
</manifest>
