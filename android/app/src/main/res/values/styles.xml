<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
    </style>


    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <!-- `android:background` is not a real window-theming attribute —
             it silently did nothing, so the Activity's window fell back to
             its default (white) background for the gap between the OS
             drawing the window and the WebView's first frame, showing as a
             white flash. `android:windowBackground` is the attribute that
             actually controls this. MainActivity never switches away from
             this theme (see MainActivity.java — no setTheme() call), so it
             stays in effect for the app's entire visible lifetime, not just
             the launch moment. -->
        <item name="android:windowBackground">@drawable/splash</item>
    </style>
</resources>