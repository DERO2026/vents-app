# Google Maps Platform — Places API (New) + Maps JavaScript API. Required here
# (not just in Vercel's dashboard env vars) because the native iOS/Android app
# bundles a LOCAL `npm run build` output via Capacitor (webDir: 'dist', no
# server.url) — without this, that build never has the key and the app falls
# back to manual address entry on every single launch, not just on failure.
VITE_GOOGLE_PLACES_API_KEY=AIzaSyA7JXjTVpg2f4DTm7VNwI9kNwNTNhhuNfk
# Same reasoning as the Maps key above: a Capacitor build bundles whatever
# `npm run build` produces locally — Vercel's dashboard/vercel.json env vars
# never reach it. This was previously missing here entirely, which meant a
# native build's Paystack popup would fail to initialize (CheckoutScreen.tsx's
# "Payment system not loaded" guard) — checkout was dead in the shipped app.
# Both are Paystack PUBLIC keys, meant to be client-exposed (same trust level
# as the anon key above).
VITE_PAYSTACK_PUBLIC_KEY=pk_test_f516541e528e30fc85465913cc38de0b07929e20
VITE_POSTHOG_KEY=phc_uVuzd3hGprUYf4QnQ76JsAUwd9aGHKF7U8MH3aC3J9c4
# Absolute origin for the /api/* Vercel functions — see src/lib/apiBase.ts.
# A Capacitor build has no relative-path server behind it to resolve
# fetch('/api/...') against, so every such call needs this. Explicit here
# even though apiBase.ts already defaults to the same value, so a future
# staging/preview native build can override it without a code change.
VITE_API_BASE=https://getvents.com
