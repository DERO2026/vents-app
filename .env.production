# Backend moved to Supabase; these were the old InsForge project's public
# creds (unused by any code path — src/lib/supabase.ts only ever reads
# VITE_SUPABASE_URL/VITE_SUPABASE_ANON_KEY). Same class of bug as the
# Paystack key below: this file had no VITE_SUPABASE_* entries at all, so a
# local production-mode build (native iOS/Android) would have gotten
# `undefined` for the DB connection had .env.local not happened to carry
# the real values too. Both are anon/public keys, safe to commit (RLS is
# the actual security boundary, same trust level as any client-side key).
VITE_SUPABASE_URL=https://slrtjxtzhowhwhebjprv.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InNscnRqeHR6aG93aHdoZWJqcHJ2Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODY3MDc0MzAsImV4cCI6MjEwMjI4MzQzMH0.XBmb6NgFMdw9Z_LHmULcG-lPxCDwmTD4AyERyqoKDbc
# Google Maps Platform — Places API (New) + Maps JavaScript API. Required here
# (not just in Vercel's dashboard env vars) because the native iOS/Android app
# bundles a LOCAL `npm run build` output via Capacitor (webDir: 'dist', no
# server.url) — without this, that build never has the key and the app falls
# back to manual address entry on every single launch, not just on failure.
VITE_GOOGLE_PLACES_API_KEY=AIzaSyA7JXjTVpg2f4DTm7VNwI9kNwNTNhhuNfk
# Same reasoning as the Maps key above: a Capacitor build bundles whatever
# `npm run build` produces locally — Vercel's dashboard/vercel.json env vars
# never reach it. This was previously missing here entirely, which meant a
# native build's Paystack popup would fail to initialize (CheckoutScreen.tsx's
# "Payment system not loaded" guard) — checkout was dead in the shipped app.
# It was then filled in with a pk_test_ key, which is exactly how a
# TestFlight build shipped with Paystack's yellow "TEST" banner: nothing
# failed, it just silently built with the wrong key (see vite.config.ts's
# production-build guard, added to make that loud instead of silent).
# Intentionally left EMPTY here — never commit a real key (test or live) to
# this tracked file. Before a native (iOS/Android) build, export the real
# pk_live_ key as an actual shell/CI environment variable; Vite prefers an
# already-set process env var over this file's value for the same name, and
# the build guard will refuse the build if this ever falls back to a
# pk_test_ value. Both Paystack keys here are PUBLIC keys (client-exposed by
# design, same trust level as the anon key above) — the secret key never
# belongs in a VITE_-prefixed var or this file.
VITE_PAYSTACK_PUBLIC_KEY=
VITE_POSTHOG_KEY=phc_uVuzd3hGprUYf4QnQ76JsAUwd9aGHKF7U8MH3aC3J9c4
# Absolute origin for the /api/* Vercel functions — see src/lib/apiBase.ts.
# A Capacitor build has no relative-path server behind it to resolve
# fetch('/api/...') against, so every such call needs this. Explicit here
# even though apiBase.ts already defaults to the same value, so a future
# staging/preview native build can override it without a code change.
VITE_API_BASE=https://getvents.com
