# Template for .env.production — a real native (iOS/Android) build needs
# these exported as actual shell/CI environment variables (Vite prefers an
# already-set process env var over .env.production's own value for the same
# name). Never fill in real values here or in .env.production itself and
# commit them — this file exists so the required variable NAMES are
# documented without any secret ever touching git. Web (Vercel) is
# unaffected by any of this — Vercel's own Production environment variables
# for these names override whatever is in .env.production.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Google Maps Platform — Places API (New) + Maps JavaScript API + Geocoding.
VITE_GOOGLE_PLACES_API_KEY=

# Paystack public (client-exposed by design) key. Must be a pk_live_ key for
# a real native production build — vite.config.ts's build guard enforces this.
VITE_PAYSTACK_PUBLIC_KEY=

# PostHog project API key (client-exposed by design).
VITE_POSTHOG_KEY=

# Absolute origin for the /api/* Vercel functions — see src/lib/apiBase.ts.
VITE_API_BASE=https://getvents.com
